<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="modHubItems">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerText" />
            <RoundCorner profile="fs25_shopMoneyBoxBg" id="diskSpaceBoxBg" />
            <BoxLayout profile="fs25_shopMoneyBox" id="diskSpaceBox">
                <Bitmap profile="fs25_modHubIconStorageSpace" />
                <Text profile="fs25_shopMoney" id="spaceUsageLabel" />
            </BoxLayout>
        </GuiElement>
        <GuiElement profile="fs25_modHubListContainer">
            <SmoothList profile="fs25_shopList" id="itemsList" onDoubleClick="onButtonDetails" listSectionHeader="section" startClipperElementName="startClipper" endClipperElementName="stopClipper">
                <ListItem profile="fs25_modHubListItem">
                    <Bitmap profile="fs25_modHubListItemBackground" />
                    <Bitmap profile="fs25_modHubListItemImage" name="icon" />
                    <Text profile="fs25_modHubListItemTitle" name="nameLabel" />
                    <BoxLayout profile="fs25_modHubMarkerBox" name="markerBox" position="-24px -24px">
                        <Bitmap profile="fs25_modHubMarkerNew" name="markerNew" />
                    </BoxLayout>
                    <ThreePartBitmap profile="fs25_modHubDLCTag" name="dlcTag">
                        <Text profile="fs25_modHubDLCTagText" text="DLC" />
                    </ThreePartBitmap>
                    <Bitmap profile="fs25_modHubInstalledBox" name="installedIcon">
                        <Bitmap profile="fs25_modHubInstalledTick" />
                    </Bitmap>
                </ListItem>
                <ListItem profile="fs25_modHubListSection" name="section" />
                <ListItem profile="fs25_modHubListItem" name="empty">
                    <Bitmap profile="fs25_modHubListItemBackgroundEmpty" />
                </ListItem>
            </SmoothList>
            <Bitmap profile="fs25_startClipper" name="startClipper" position="-2px -0px" />
            <Bitmap profile="fs25_stopClipper" name="stopClipper" position="-2px 0px" />
        </GuiElement>
        <BoxLayout profile="fs25_modHubAttributeBox" id="modAttributeBox">
            <Text profile="fs25_modHubAttributeName" id="modAttributeName" />
            <Text profile="fs25_modHubAttributeInfo" text="  |  " />
            <Text profile="fs25_modHubAttributeInfo" id="modAttributeInfoAuthor" />
            <Text profile="fs25_modHubAttributeInfo" text="  |  " />
            <Text profile="fs25_modHubAttributeInfo" id="modAttributeInfoVersion" />
            <Text profile="fs25_modHubAttributeInfo" text="  |  " id="modAttributeInfoRatingSpace" />
            <BoxLayout profile="fs25_modHubAttributeRatingBox" id="modAttributeRatingBox">
                <Bitmap profile="fs25_modHubAttributeRatingStar" id="modAttributeRatingStar[1]">
                    <Bitmap profile="fs25_modHubAttributeRatingStarHalf" id="modAttributeRatingStarHalf[1]" />
                </Bitmap>
                <Bitmap profile="fs25_modHubAttributeRatingStar" id="modAttributeRatingStar[2]">
                    <Bitmap profile="fs25_modHubAttributeRatingStarHalf" id="modAttributeRatingStarHalf[2]" />
                </Bitmap>
                <Bitmap profile="fs25_modHubAttributeRatingStar" id="modAttributeRatingStar[3]">
                    <Bitmap profile="fs25_modHubAttributeRatingStarHalf" id="modAttributeRatingStarHalf[3]" />
                </Bitmap>
                <Bitmap profile="fs25_modHubAttributeRatingStar" id="modAttributeRatingStar[4]">
                    <Bitmap profile="fs25_modHubAttributeRatingStarHalf" id="modAttributeRatingStarHalf[4]" />
                </Bitmap>
                <Bitmap profile="fs25_modHubAttributeRatingStar" id="modAttributeRatingStar[5]">
                    <Bitmap profile="fs25_modHubAttributeRatingStarHalf" id="modAttributeRatingStarHalf[5]" />
                </Bitmap>
            </BoxLayout>
            <Text profile="fs25_modHubAttributeInfo" text="  |  " id="modAttributeInfoSizeSpace" />
            <Text profile="fs25_modHubAttributeInfo" id="modAttributeInfoSize" />
            <Text profile="fs25_modHubAttributeInfo" text="  |  " id="modAttributeInfoPriceSpace" />
            <Text profile="fs25_modHubAttributeName" id="modAttributePrice" />
        </BoxLayout>
        <Text profile="fs25_modHubNoModsText" id="noModsElement" text="$l10n_modHub_noMods" />
        <Text profile="fs25_modHubAbuseText" id="disclaimerLabel" text="$l10n_modHub_abuse" position="0px -40px" />
    </GuiElement>
    <ThreePartBitmap profile="fs25_sliderDockedBg">
        <ThreePartBitmap profile="fs25_sliderDockedBox">
            <Slider profile="fs25_sliderDocked" dataElementId="itemsList" />
        </ThreePartBitmap>
    </ThreePartBitmap>
</GUI>