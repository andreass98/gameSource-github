<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="shopOthers">
    <GuiElement profile="fs25_shopContainer">
        <GuiElement profile="fs25_shopHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="categoryHeaderIcon" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" />
        </GuiElement>
        <GuiElement profile="fs25_saveContainer">
            <BoxLayout profile="fs25_saveLayout" id="buttonsLayout">
                <Button profile="fs25_saveButton" onClick="onOpenAnimalDealer" focusInit="onOpen" onFocus="onButtonFocused">
                    <Bitmap profile="fs25_saveButtonBg" />
                    <Bitmap profile="fs25_saveButtonIcon" imageSliceId="gui.icon_others_animalDealer" />
                    <Text profile="fs25_saveButtonText" text="$l10n_ui_animalDealerScreen" />
                </Button>
                <Button profile="fs25_saveButton" onClick="onOpenWardrobeScreen" onFocus="onButtonFocused">
                    <Bitmap profile="fs25_saveButtonBg" />
                    <Bitmap profile="fs25_saveButtonIcon" imageSliceId="gui.icon_others_wardrobe" />
                    <Text profile="fs25_saveButtonText" text="$l10n_ui_wardrobeScreen" />
                </Button>
                <Button profile="fs25_saveButton" onClick="onOpenConstructionScreen" onFocus="onButtonFocused">
                    <Bitmap profile="fs25_saveButtonBg" />
                    <Bitmap profile="fs25_saveButtonIcon" imageSliceId="gui.icon_others_construction" />
                    <Text profile="fs25_saveButtonText" text="$l10n_ui_constructionScreen" />
                </Button>
                <Button profile="fs25_saveButton" onClick="onOpenFarmlandScreen" onFocus="onButtonFocused">
                    <Bitmap profile="fs25_saveButtonBg" />
                    <Bitmap profile="fs25_saveButtonIcon" imageSliceId="gui.icon_others_farmland" />
                    <Text profile="fs25_saveButtonText" text="$l10n_ui_farmlandScreen" />
                </Button>
                <Button profile="fs25_saveButton" onClick="onOpenVehicleOverview" onFocus="onButtonFocused">
                    <Bitmap profile="fs25_saveButtonBg" />
                    <Bitmap profile="fs25_saveButtonIcon" imageSliceId="gui.icon_others_ownedVehicles" />
                    <Text profile="fs25_saveButtonText" text="$l10n_ui_garageOverview" />
                </Button>
            </BoxLayout>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" />
            <MultiTextOption profile="fs25_hintMultiTextOption" id="gameplayHintSelector" onFocus="updateMenuButtons" onLeave="updateMenuButtons" />
            <IndexState profile="fs25_hintSelectorBox" id="hintStateBox" stateElementTemplateId="hintTemplate" indexableElementId="gameplayHintSelector">
                <RoundCorner profile="fs25_subCategorySelectorDot" id="hintTemplate" />
            </IndexState>
        </GuiElement>
    </GuiElement>
</GUI>