<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_optionDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" position="0px -40px" />
            <Text profile="fs25_dialogText" id="dialogTextElement" position="0px -80px" />
            <MultiTextOption profile="fs25_optionDialogMultiTextOption" id="optionElement" focusInit="onOpen">
                <Text profile="fs25_multiTextOptionText" width="400px" name="text" />
            </MultiTextOption>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK" text="$l10n_button_ok" onClick="onClickOk" id="yesButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_optionDialogBg" extends="fs25_dialogBg">
            <height value="270px" />
            <Variant name="mobile">
                <size value="1400px 300px" />
            </Variant>
        </Profile>
        <Profile name="optionDialogText" extends="dialogTextWithTitle">
            <position value="0px -35px" />
            <textWrapWidth value="420px" />
            <Variant name="mobile">
                <textMaxWidth value="850px" />
            </Variant>
        </Profile>
        <Profile name="fs25_optionDialogMultiTextOption" extends="fs25_multiTextOption" with="anchorBottomCenter">
            <width value="500px" />
            <position value="0px 30px" />
            <Variant name="mobile">
                <size value="800px 105px" />
            </Variant>
        </Profile>
        <Profile name="optionDialogMultiTextOptionText" extends="multiTextOptionText">
            <textMaxNumLines value="3" />
            <textMaxWidth value="480px" />
        </Profile>
    </GUIProfiles>
</GUI>