<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_vehicleShopBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" position="0px -35px" />
            <Text profile="fs25_vehicleShopText" id="dialogDescriptionElement" text="$l10n_ui_vehicleShopDescription:" />
            <Bitmap profile="fs25_vehicleShopIcon" id="vehicleIconElement" />
            <MultiTextOption profile="fs25_vehicleShopMultiTextOption" id="itemsElement" position="350px 195px" onClick="onClickItems" />
            <Text profile="fs25_vehicleShopText" id="functionText" position="350px 165px" textMaxNumLines="3" />
            <Text profile="fs25_vehicleShopPriceText" text="$l10n_shop_configurationPriceBase:" position="360px 80px" />
            <Text profile="fs25_vehicleShopPriceValue" id="basePriceText" position="450px 80px" />
            <Text profile="fs25_vehicleShopPriceText" text="$l10n_ui_transportCost:" position="360px 50px" />
            <Text profile="fs25_vehicleShopPriceValue" id="transportPriceText" position="450px 50px" />
            <ThreePartBitmap profile="fs25_vehicleShopPriceBg" position="350px 20px" />
            <Text profile="fs25_vehicleShopPriceText" text="$l10n_shop_configurationPriceTotal:" position="360px 20px" />
            <Text profile="fs25_vehicleShopPriceValue" id="totalPriceText" position="450px 20px" />
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonYes" text="$l10n_button_buy" onClick="onYes" id="yesButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonNo" text="$l10n_button_back" onClick="onNo" id="noButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_vehicleShopBg" extends="fs25_dialogBg">
            <size value="900px 430px" />
        </Profile>
        <Profile name="fs25_vehicleShopText" extends="fs25_dialogText" with="anchorBottomLeft">
            <width value="500px" />
            <position value="350px 240px" />
            <textAlignment value="left" />
        </Profile>
        <Profile name="fs25_vehicleShopMultiTextOption" extends="fs25_dialogMultiTextOption" with="anchorBottomLeft" />
        <Profile name="fs25_vehicleShopIcon" extends="baseReference">
            <size value="300px 300px" />
            <position value="20px 40px" />
            <imageSliceId value="noSlice" />
        </Profile>
        <Profile name="fs25_vehicleShopPriceBg" extends="baseReference" with="anchorBottomLeft">
            <size value="280px 30px" />
            <imageColor value="$preset_fs25_colorGrey" />
            <imageSliceId value="gui.rectangle_center" />
            <startImageSize value="10px 0" />
            <startImageSliceId value="gui.rectangle_left" />
            <endImageSize value="10px 0" />
            <endImageSliceId value="gui.rectangle_right" />
        </Profile>
        <Profile name="fs25_vehicleShopPriceText" extends="fs25_textDefault" with="anchorBottomLeft">
            <size value="170px 30px" />
            <textSize value="14px" />
            <textBold value="true" />
            <textUpperCase value="true" />
        </Profile>
        <Profile name="fs25_vehicleShopPriceValue" extends="fs25_vehicleShopPriceText">
            <textAlignment value="right" />
        </Profile>
    </GUIProfiles>
</GUI>