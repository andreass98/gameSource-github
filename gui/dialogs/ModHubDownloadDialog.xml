<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_modHubDownloadDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_dialogHeaderText" text="$l10n_modHub_download" position="-10px -50px" />
            <GuiElement profile="fs25_modHubDownloadListContainer">
                <SmoothList profile="fs25_modHubDownloadList" id="downloadList" handleFocus="false">
                    <ListItem profile="fs25_modHubDownloadListItem">
                        <ThreePartBitmap profile="fs25_modHubDownloadListBg" />
                        <Bitmap profile="fs25_modHubDownloadListIcon" name="icon" />
                        <Text profile="fs25_modHubDownloadListName" name="name" />
                        <Text profile="fs25_modHubDownloadListPercentage" name="percentage" text="0%" />
                        <Text profile="fs25_modHubDownloadListTextFailed" name="failed" text="$l10n_modHub_failed" />
                        <ThreePartBitmap profile="fs25_modHubDownloadListStatusBarBackground">
                            <ThreePartBitmap profile="fs25_modHubDownloadListStatusBar" name="statusBar" />
                        </ThreePartBitmap>
                    </ListItem>
                </SmoothList>
                <ThreePartBitmap profile="fs25_listSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="downloadList" handleFocus="true" focusInit="onOpen" />
                </ThreePartBitmap>
            </GuiElement>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="backButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_modHubDownloadDialogBg" extends="fs25_dialogBg">
            <size value="820px 600px" />
        </Profile>
        <Profile name="fs25_modHubDownloadListContainer" extends="emptyPanel" with="anchorStretchingYStretchingX pivotBottomCenter">
            <absoluteSizeOffset value="150px 165px" />
            <position value="0px 40px" />
        </Profile>
        <Profile name="fs25_modHubDownloadList" extends="emptyPanel" with="anchorStretchingYStretchingX">
            <listItemSpacing value="10px" />
        </Profile>
        <Profile name="fs25_modHubDownloadListItem" extends="emptyPanel" with="anchorTopStretchingX">
            <height value="78px" />
        </Profile>
        <Profile name="fs25_modHubDownloadListBg" extends="baseReference" with="anchorMiddleStretchingX">
            <imageSliceId value="gui.modhub_downloadBox_middle" />
            <startImageSliceId value="gui.modhub_downloadBox_left" />
            <startImageSize value="18px 0" />
            <endImageSliceId value="gui.modhub_downloadBox_right" />
            <endImageSize value="18px 0" />
        </Profile>
        <Profile name="fs25_modHubDownloadListIcon" extends="baseReference" with="anchorTopLeft">
            <size value="78px 78px" />
            <imageSliceId value="noSlice" />
            <imageMaskFilename value="dataS/menu/mask_modhubDownload.png" />
            <overlayMaskSize value="128px 128px" />
            <overlayMaskPos value="-25px -25px" />
        </Profile>
        <Profile name="fs25_modHubDownloadListName" extends="fs25_textDefault" with="anchorTopLeft">
            <width value="320px" />
            <position value="100px -20px" />
        </Profile>
        <Profile name="fs25_modHubDownloadListPercentage" extends="fs25_textDefault" with="anchorTopRight">
            <width value="200px" />
            <position value="-20px -20px" />
            <textAlignment value="right" />
            <textColor value="$preset_fs25_colorMainHighlight" />
        </Profile>
        <Profile name="fs25_modHubDownloadListStatusBarBackground" extends="emptyPanel" with="anchorBottomStretchingX pivotBottomRight">
            <height value="6px" />
            <absoluteSizeOffset value="120px 0px" />
            <position value="-20px 25px" />
            <imageSliceId value="gui.progressbar_middle" />
            <imageColor value="$preset_fs25_colorMainDark" />
            <imageSelectedColor value="$preset_fs25_colorMainDark" />
            <startImageSize value="5px 0" />
            <startImageSliceId value="gui.progressbar_left" />
            <endImageSize value="5px 0" />
            <endImageSliceId value="gui.progressbar_right" />
        </Profile>
        <Profile name="fs25_modHubDownloadListStatusBar" extends="emptyPanel" with="anchorStretchingYStretchingX pivotMiddleLeft">
            <position value="-0.5px 0px" />
            <imageSliceId value="gui.progressbar_middle" />
            <imageColor value="$preset_fs25_colorMainHighlight" />
            <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
            <startImageSize value="5px 0" />
            <startImageSliceId value="gui.progressbar_left" />
            <endImageSize value="5px 0" />
            <endImageSliceId value="gui.progressbar_right" />
        </Profile>
        <Profile name="fs25_modHubDownloadListTextFailed" extends="fs25_textDefault" with="anchorBottomLeft">
            <position value="100px 15px" />
            <textColor value="$preset_colorRed" />
            <textUpperCase value="true" />
        </Profile>
    </GUIProfiles>
</GUI>