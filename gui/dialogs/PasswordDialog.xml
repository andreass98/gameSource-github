<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_passwordDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="fs25_passwordDialogText" id="dialogTextElement" text="$l10n_ui_enterPassword:" />
            <TextInput profile="fs25_dialogTextInput" id="textElement" onEnterPressed="onEnterPressed" onEscPressed="onEscPressed" enterWhenClickOutside="false" imeKeyboardType="password" imeTitle="$l10n_ui_password" imeDescription="$l10n_ui_password" imePlaceholder="$l10n_ui_password" isPassword="true">
                <ThreePartBitmap profile="fs25_textInputBg" />
                <Bitmap profile="fs25_dialogTextInputIconBox">
                    <Bitmap profile="fs25_dialogTextInputIcon" />
                </Bitmap>
            </TextInput>
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK" text="$l10n_button_start" onClick="onClickOk" id="yesButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" id="noButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_passwordDialogBg" extends="fs25_dialogBg">
            <size value="600px 200px" />
        </Profile>
        <Profile name="fs25_passwordDialogText" extends="fs25_dialogText">
            <position value="0px -25px" />
            <textSize value="15px" />
            <textWrapWidth value="370px" />
        </Profile>
    </GUIProfiles>
</GUI>