        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_savegameUploadDialogBg" extends="fs25_dialogBg">
            <size value="490px 220px" />
        </Profile>
        <Profile name="fs25_savegameUploadDialogTitle" extends="fs25_dialogText">
            <position value="0px -35px" />
            <textSize value="15px" />
            <textWrapWidth value="370px" />
        </Profile>
    </GUIProfiles>
