<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_multiOptionDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Animation profile="fs25_dialogLoading" id="iconLoadingElement" />
            <Bitmap profile="fs25_dialogCircle" id="dialogCircle">
                <Bitmap profile="fs25_dialogQuestion" id="iconQuestionElement" />
                <Bitmap profile="fs25_dialogWarning" id="iconWarningElement" />
                <Bitmap profile="fs25_dialogKey" id="iconKeyElement" />
                <Bitmap profile="fs25_dialogInfo" id="iconInfoElement" />
            </Bitmap>
            <Text profile="fs25_dialogTitle" id="dialogTitleElement" text="" />
            <Text profile="fs25_dialogTextWithTitle" id="dialogTextElement" text="" />
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonBox" name="aaaTest">
            <Button profile="buttonCancel" onClick="onCancel" id="buttonCancel">
                <Bitmap profile="fs25_dialogButtonBoxSeparator" name="separator" />
            </Button>
            <Button profile="buttonActivate" onClick="onActivate" id="buttonActivate">
                <Bitmap profile="fs25_dialogButtonBoxSeparator" name="separator" />
            </Button>
            <Button profile="buttonBack" onClick="onBack" id="buttonBack">
                <Bitmap profile="fs25_dialogButtonBoxSeparator" name="separator" />
            </Button>
            <Button profile="buttonOK" onClick="onAccept" id="buttonAccept">
                <Bitmap profile="fs25_dialogButtonBoxSeparator" name="separator" />
            </Button>
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_multiOptionDialogBg" extends="fs25_dialogBg">
            <height value="295px" />
            <Variant name="mobile">
                <size value="1400px 250px" />
            </Variant>
        </Profile>
    </GUIProfiles>
</GUI>