<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="connectionFailedDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Animation profile="fs25_dialogLoading" id="iconLoadingElement" />
            <Bitmap profile="fs25_dialogCircle" id="dialogCircle">
                <Bitmap profile="fs25_dialogQuestion" id="iconQuestionElement" />
                <Bitmap profile="fs25_dialogWarning" id="iconWarningElement" />
                <Bitmap profile="fs25_dialogKey" id="iconKeyElement" />
                <Bitmap profile="fs25_dialogInfo" id="iconInfoElement" />
            </Bitmap>
            <Text profile="connectionFailedDialogText" text="" id="dialogTextElement" />
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox" id="buttonsPC">
            <Button profile="buttonOK" text="$l10n_button_ok" onClick="onClickOk" id="okButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="connectionFailedDialogBg" extends="fs25_dialogBg">
            <height value="300px" />
            <Variant name="mobile">
                <size value="1400px 300px" />
            </Variant>
        </Profile>
        <Profile name="connectionFailedDialogText" extends="fs25_dialogText">
            <Variant name="mobile">
                <textSize value="40px" />
                <position value="0px -210px" />
                <textMaxNumLines value="7" />
            </Variant>
        </Profile>
    </GUIProfiles>
</GUI>