<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="yesNoDialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall" />
        <ThreePartBitmap profile="fs25_dialogBgTopSmall" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />
        <GuiElement profile="fs25_dialogContentContainer">
            <Animation profile="fs25_dialogLoading" id="iconLoadingElement" />
            <Bitmap profile="fs25_dialogCircle" id="dialogCircle">
                <Bitmap profile="fs25_dialogQuestion" id="iconQuestionElement" />
                <Bitmap profile="fs25_dialogWarning" id="iconWarningElement" />
                <Bitmap profile="fs25_dialogKey" id="iconKeyElement" />
                <Bitmap profile="fs25_dialogInfo" id="iconInfoElement" />
            </Bitmap>
            <Text profile="yesNoDialogTitle" text="" id="dialogTitleElement" />
            <Text profile="yesNoDialogTextWithTitle" text="" id="dialogTextElement" />
        </GuiElement>
        <BoxLayout profile="fs25_dialogButtonBox">
            <Button profile="buttonYes" text="$l10n_button_yes" onClick="onYes" id="yesButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonNo" text="$l10n_button_no" onClick="onNo" id="noButton" />
        </BoxLayout>
    </GuiElement>
    <GUIProfiles>
        <Profile name="yesNoDialogBg" extends="fs25_dialogBg">
            <height value="295px" />
            <Variant name="mobile">
                <size value="1400px 250px" />
            </Variant>
        </Profile>
        <Profile name="yesNoDialogCircle" extends="fs25_dialogCircle">
            <Variant name="mobile">
                <visible value="false" />
                <position value="0px -30px" />
            </Variant>
        </Profile>
        <Profile name="yesNoDialogTitle" extends="fs25_dialogTitle">
            <Variant name="mobile">
                <position value="0px -170px" />
                <textColor value="1 1 1 1" />
                <margin value="0 30px 0 30px" />
                <textSize value="40px" />
                <textMaxNumLines value="7" />
            </Variant>
        </Profile>
        <Profile name="yesNoDialogTextWithTitle" extends="fs25_dialogTextWithTitle">
            <Variant name="mobile">
                <position value="0px -170px" />
                <textColor value="1 1 1 1" />
                <margin value="0 30px 0 30px" />
                <textSize value="40px" />
                <textMaxNumLines value="7" />
            </Variant>
        </Profile>
    </GUIProfiles>
</GUI>