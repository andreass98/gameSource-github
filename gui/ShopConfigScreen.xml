            <textAlignment value="right" />
            <textAutoWidth value="true" />
            <textMaxWidth value="125px" />
            <textLayoutMode value="resize" />
        </Profile>
        <Profile name="fs25_shopConfigPriceValueTotal" extends="fs25_shopConfigPriceValue">
