<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="fs25_shopConfigContainerLeft" id="configurationsBox">
        <Text profile="fs25_shopConfigConfigurationTitle" text="$l10n_shop_configurations" id="configurationsTitle" />
        <GuiElement profile="fs25_shopConfigConfigurationLayoutBox">
            <Bitmap profile="fs25_shopConfigStartClipper" id="startClipper" />
            <Bitmap profile="fs25_shopConfigStopClipper" id="endClipper" />
            <ScrollingLayout profile="fs25_shopConfigConfigurationLayout" id="configurationLayout">
                <GuiElement profile="fs25_shopConfigConfigurationItem" id="configurationItemTemplate">
                    <MultiTextOption profile="fs25_multiTextOption" name="option" onFocus="onFocusConfigurationOption" onLeave="onLeaveConfigurationOption" visible="false" width="100%" />
                    <BinaryOption profile="fs25_binaryOption" name="yesNoOption" onFocus="onFocusConfigurationOption" onLeave="onLeaveConfigurationOption" visible="false" width="100%" />
                    <Button profile="fs25_colorButton" name="color" onFocus="onFocusConfigurationOption" onLeave="onLeaveConfigurationOption" visible="false">
                        <ThreePartBitmap profile="fs25_colorButtonPicked" name="colorImage" />
                        <Bitmap profile="fs25_colorButtonPickedMetallic" name="colorImageMetallic" />
                        <Bitmap profile="fs25_colorButtonPickedGlossy" name="colorImageGlossy" />
                        <Bitmap profile="fs25_colorButtonPickedMatte" name="colorImageMatte" />
                        <Bitmap profile="fs25_colorButtonIconBox">
                            <Bitmap profile="fs25_colorButtonIcon" />
                        </Bitmap>
                        <Bitmap profile="fs25_colorButtonOverlay" />
                    </Button>
                    <Text profile="fs25_shopMultiTextOptionTitle" name="title" />
                    <Text profile="fs25_shopMultiTextOptionPrice" name="price" />
                </GuiElement>
                <GuiElement profile="fs25_shopConfigConfigurationItemPlate" id="configurationItemPlate">
                    <Button profile="fs25_shopConfigConfigurationButton" name="button" onFocus="onFocusConfigurationOption" onLeave="onLeaveConfigurationOption" onClick="onClickLicensePlate">
                        <Render profile="fs25_shopConfigLicensePlateRender" filename="dataS/menu/licensePlate/creationBox.i3d" cameraNode="0|1" superSamplingFactor="2" id="licensePlateRender" onRenderLoad="onRenderLoad" />
                    </Button>
                    <Text profile="fs25_shopMultiTextOptionTitle" name="title" text="$l10n_ui_licensePlate" />
                    <Text profile="fs25_shopMultiTextOptionPrice" name="price" />
                </GuiElement>
                <GuiElement profile="fs25_shopConfigConfigurationItemLarge" id="configurationItemTemplateLarge">
                    <MultiTextOption profile="fs25_shopMultiTextOptionLarge" name="option" onFocus="onFocusConfigurationOption" onLeave="onLeaveConfigurationOption" visible="false">
                        <Bitmap profile="fs25_shopMultiTextOptionLargeIcon" name="icon" />
                    </MultiTextOption>
                    <Text profile="fs25_shopMultiTextOptionTitle" name="title" />
                    <Text profile="fs25_shopMultiTextOptionPrice" name="price" />
                </GuiElement>
            </ScrollingLayout>
            <ThreePartBitmap profile="fs25_listSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="configurationLayout" id="configSlider" />
            </ThreePartBitmap>
        </GuiElement>
        <Text profile="fs25_shopConfigPriceCost" position="45px 210px" text="$l10n_shop_costsCalculation" />
        <Text profile="fs25_shopConfigPriceTitle" position="45px 175px" text="$l10n_shop_configurationPriceBase:" />
        <Text profile="fs25_shopConfigPriceValue" position="-65px 175px" id="basePriceText" />
        <Text profile="fs25_shopConfigPriceTitle" position="45px 140px" text="$l10n_shop_configurationPriceOptions:" />
        <Text profile="fs25_shopConfigPriceValue" position="-65px 140px" id="upgradesPriceText" />
        <Text profile="fs25_shopConfigPriceTitle" position="45px 105px" text="$l10n_shop_configurationPriceTotal:" />
        <Text profile="fs25_shopConfigPriceValueTotal" position="-65px 105px" id="totalPriceText" />
    </Bitmap>
    <Bitmap profile="fs25_shopConfigContainerMiddle">
        <Bitmap profile="fs25_shopConfigBrandIcon" id="shopConfigBrandIcon" />
        <Text profile="fs25_shopConfigItemName" id="shopConfigItemName" />
        <BoxLayout profile="fs25_shopConfigAttributesLayout" id="attributesLayout">
            <GuiElement profile="fs25_shopConfigAttributesItem" id="attributeItem">
                <Bitmap profile="shopConfigAttributesIcon" name="icon" />
                <Text profile="fs25_shopConfigAttributesValue" name="text" />
            </GuiElement>
        </BoxLayout>
    </Bitmap>
    <GuiElement profile="fs25_shopConfigContainer" id="shopConfigContent">
        <Animation profile="fs25_shopConfigLoadingAnimation" id="loadingAnimation" visible="false" />
    </GuiElement>
    <GuiElement profile="fs25_shopConfigMoneyContainer" debugEabled="true">
        <RoundCorner profile="fs25_shopConfigMoneyBoxBg" id="shopMoneyBoxBg" />
        <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
            <Bitmap profile="fs25_shopSlotsIcon" id="shopSlotsIcon" />
            <Text profile="fs25_shopSlots" text="0 / 0" id="shopSlotsText" />
            <Text profile="fs25_shopBalance" text="$l10n_ui_balance:" />
            <Text profile="fs25_shopMoney" id="currentBalanceText" />
        </BoxLayout>
    </GuiElement>
    <BoxLayout profile="fs25_buttonBox" id="buttonsPanel">
        <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" />
        <Button profile="buttonCancel" id="configButton" text="$l10n_button_change" onClick="onClickConfigAction" visible="false">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator" />
        </Button>
        <Button profile="buttonActivate" id="leaseButton" text="$l10n_button_lease" onClick="onClickLease">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator" />
        </Button>
        <Button profile="buttonBuy" id="buyButton" text="$l10n_ui_purchase" onClick="onClickBuy">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator" />
        </Button>
        <Text profile="fs25_inputGlyphText" textAutoWidth="true" text="$l10n_action_cameraZoom">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator" position="17px 0px" />
        </Text>
        <InputGlyph profile="fs25_inputGlyph" id="zoomGlyph" isLeftAligned="true" />
        <Text profile="fs25_inputGlyphText" textAutoWidth="true" text="$l10n_action_rotateCamera">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator" position="17px 0px" />
        </Text>
        <InputGlyph profile="fs25_inputGlyph" id="lookGlyph" isLeftAligned="true" />
    </BoxLayout>
    <GUIProfiles>
        <Profile name="fs25_shopConfigContainerLeft" extends="baseReference" with="anchorStretchingYLeft">
            <width value="410px" />
            <imageColor value="$preset_fs25_colorMainDark_90" />
