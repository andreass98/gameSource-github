<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="settingsDevice">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_options_device" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="titleElement" text="$l10n_ui_ingameMenuGameSettingsGame" />
        </GuiElement>
        <ScrollingLayout profile="fs25_settingsLayout" id="layout" topClipperElementName="topClipper" bottomClipperElementName="bottomClipper">
            <GuiElement profile="fs25_settingsSectionHeader" id="sectionTemplate" name="sectionHeader">
                <Text profile="fs25_settingsSectionHeader" name="title" />
                <Bitmap profile="fs25_settingsDeviceValueBox" name="box">
                    <Bitmap profile="fs25_settingsDeviceValueBar" />
                </Bitmap>
            </GuiElement>
            <Bitmap profile="fs25_multiTextOptionContainer" id="deadzoneTemplate">
                <MultiTextOption profile="fs25_settingsMultiTextOption" />
                <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_setting_gamepadDeadzone" />
            </Bitmap>
            <Bitmap profile="fs25_multiTextOptionContainer" id="sensitivityTemplate">
                <MultiTextOption profile="fs25_settingsMultiTextOption" />
                <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_setting_gamepadSensitivity" />
            </Bitmap>
        </ScrollingLayout>
        <Bitmap profile="fs25_startClipper" name="topClipper" />
        <Bitmap profile="fs25_stopClipper" name="bottomClipper" />
    </GuiElement>
    <ThreePartBitmap profile="fs25_sliderDockedBg">
        <ThreePartBitmap profile="fs25_sliderDockedBox">
            <Slider profile="fs25_sliderDocked" dataElementId="layout" />
        </ThreePartBitmap>
    </ThreePartBitmap>
    <GUIProfiles />
</GUI>