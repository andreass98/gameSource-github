<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="settingsHDR">
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="gui.icon_options_displaySettings" />
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_setting_hdr" />
        </GuiElement>
        <GuiElement profile="hdrSettingsBox" id="settingsContainer">
            <ScrollingLayout profile="fs25_settingsLayoutHDR" id="boxLayout" topClipperElementName="topClipper" bottomClipperElementName="bottomClipper">
                <Bitmap profile="fs25_multiTextOptionContainerHDR">
                    <OptionSlider profile="fs25_settingsHdrOptionSlider" id="hdrPeakBrightnessElement" onClick="onClickHDRPeakBrightness" onCreate="onCreateHDRPeakBrightness" focusInit="onOpen">
                        <Text profile="fs25_optionSliderTextHDR" name="text" />
                    </OptionSlider>
                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_setting_hdrPeakBrightness" />
                </Bitmap>
                <Bitmap profile="fs25_multiTextOptionContainerHDR">
                    <OptionSlider profile="fs25_settingsHdrOptionSlider" id="hdrContrastElement" onClick="onClickHDRContrast" onCreate="onCreateHDRContrast">
                        <Text profile="fs25_optionSliderTextHDR" name="text" />
                    </OptionSlider>
                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_setting_hdrContrast" />
                </Bitmap>
                <Bitmap profile="fs25_multiTextOptionContainerHDR">
                    <OptionSlider profile="fs25_settingsHdrOptionSlider" id="overlayBrightnessElement" onClick="onClickOverlayBrightness" onCreate="onCreateOverlayBrightness">
                        <Text profile="fs25_optionSliderTextHDR" name="text" />
                    </OptionSlider>
                    <Text profile="fs25_settingsMultiTextOptionTitle" text="$l10n_setting_overlayBrightness" />
                </Bitmap>
            </ScrollingLayout>
            <GuiElement profile="hdrImageBox">
                <Clear imageUVs="0 0 1 1" anchors="0.5 0.5 0.5 0.5" size="1208px 680px" id="hdrImage" visible="true" />
                <BinaryOption profile="fs25_binaryOption" id="hdrSceneElement" onClick="onClickHDRSceneChange" anchors="0.5 0 0.5 0" position="0px -36px" />
            </GuiElement>
        </GuiElement>
    </GuiElement>
    <GUIProfiles>
        <Profile name="fs25_optionSliderTextHDR" extends="fs25_optionSliderText" with="anchorBottomRight">
            <position value="270px 0px" />
            <textAlignment value="right" />
        </Profile>
        <Profile name="fs25_multiTextOptionContainerHDR" extends="fs25_multiTextOptionContainer">
            <width value="1208px" />
        </Profile>
        <Profile name="fs25_settingsLayoutHDR" extends="fs25_settingsLayout">
            <width value="1208px" />
        </Profile>
        <Profile name="hdrSettingsBox" extends="emptyPanel" with="anchorBottomCenter">
            <size value="1400px 835px" />
        </Profile>
        <Profile name="hdrImageBox" extends="baseReference" with="anchorBottomCenter">
            <size value="1208px 680px" />
            <imageColor value="0 0 0 0" />
        </Profile>
        <Profile name="fs25_settingsHdrOptionContainer" extends="multiTextOptionWithTitleText">
            <size value="1400px 48px" />
            <margin value="0 12px 0 12px" />
        </Profile>
        <Profile name="fs25_settingsHdrOptionSlider" extends="fs25_optionSlider">
            <size value="600px 48px" />
            <wrap value="false" />
        </Profile>
        <Profile name="fs25_settingsHdrOptionTitle" extends="fs25_textDefault" with="anchorMiddleLeft">
            <size value="0 48px" />
            <textSize value="20px" />
            <textMaxWidth value="380px" />
            <textAutoWidth value="true" />
            <textMaxNumLines value="2" />
        </Profile>
    </GUIProfiles>
</GUI>