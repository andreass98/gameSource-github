<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="valtraTop" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/characterShader.xml" />
    <File fileId="1" filename="$dataS/character/textures/shirts/valtraTop_diffuse.png" />
    <File fileId="5" filename="$dataS/character/textures/shirts/valtraTop_mask.png" />
    <File fileId="2" filename="$dataS/character/textures/shirts/valtraTop_normal.png" />
    <File fileId="3" filename="$dataS/character/textures/shirts/valtraTop_specular.png" />
  </Files>

  <Materials>
    <Material name="valtraTop_mat" materialId="1" customShaderId="4">
      <CustomParameter name="colorScaleG" value="0.220 0.250 0.440 1.0"/>
      <CustomParameter name="colorScaleR" value="0.500 0.500 0.500 1.0"/>
      <CustomParameter name="sssColor" value="0.938 0.938 0.938 1.0"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="valtraTop.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="valtraTop" collision="false" collisionFilterMask="0xfffffbff" clipDistance="300" nodeId="1">
      <Shape name="top" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" nodeId="2"/>
      <Shape name="hands" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="1" nodeId="3"/>
      <Shape name="under" shapeId="3" castsShadows="true" receiveShadows="true" materialIds="1" nodeId="4"/>
      <Shape name="over" shapeId="4" castsShadows="true" receiveShadows="true" materialIds="1" nodeId="5"/>
    </TransformGroup>
  </Scene>

</i3D>
