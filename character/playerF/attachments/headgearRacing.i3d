<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="headgearRacing" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/characterShader.xml" />
    <File fileId="6" filename="$dataS/character/textures/accessory/head/hats/headgearRacingGlass_normal.png" />
    <File fileId="1" filename="$dataS/character/textures/accessory/head/hats/headgearRacing_diffuse.png" />
    <File fileId="5" filename="$dataS/character/textures/accessory/head/hats/headgearRacing_mask.png" />
    <File fileId="2" filename="$dataS/character/textures/accessory/head/hats/headgearRacing_normal.png" />
    <File fileId="3" filename="$dataS/character/textures/accessory/head/hats/headgearRacing_specular.png" />
  </Files>

  <Materials>
    <Material name="headgearRacing_mat" materialId="1" customShaderId="4">
      <CustomParameter name="colorScaleG" value="1.0 1.0 1.0 1.0"/>
      <CustomParameter name="colorScaleR" value="1.0 1.0 1.0 1.0"/>
      <CustomParameter name="dirtColor" value="0.20 0.14 0.08 0.0"/>
      <CustomParameter name="sssColor" value="1.0 1.0 1.0 1.0"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="headgearRacingGlass_mat" materialId="2" diffuseColor="0.15 0.15 0.15 1" specularColor="0.88 0.88 0.88">
      <Normalmap fileId="6"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="headgearRacing.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="animationRootNode" nodeId="1"/>
    <TransformGroup name="headgearRacing" collision="false" collisionFilterMask="0xfffffbff" clipDistance="300" nodeId="2">
      <Shape name="headgearRacing" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="3"/>
      <Shape name="headgearRacingGlass" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="300" nodeId="4"/>
    </TransformGroup>
  </Scene>

</i3D>
