<?xml version="1.0" encoding="utf-8" standalone="no"?>
<conditionalAnimation>
    <item id="idle">
        <clips>
            <clip clipName="idle1FemaleSource" />
        </clips>
        <conditions>
            <conditionGroup>
                <condition parameter="isIdling" equal="true" />
                <condition parameter="isHoldingChainsaw" equal="false" />
                <condition parameter="isGrounded" equal="true" />
                <condition parameter="isCrouching" equal="false" />
                <condition parameter="isSwimming" equal="false" />
                <condition parameter="rotationVelocity" between="-0.01, 0.01" />
            </conditionGroup>
        </conditions>
    </item>
