<?xml version="1.0" encoding="utf-8" standalone="no"?>
<animation>
    <states>
        <state id="walk">
            <animation id="walk1" clipLeft="walkFwdLBabySource" clipRight="walkFwdRBabySource" rotation="65" speed="1.0" distance="0.334" />
            <animation id="walk2" clipLeft="trotFwdLBabySource" clipRight="trotFwdRBabySource" rotation="65" speed="8.63" distance="0.821" />
        </state>
        <state id="idle">
            <animation id="idle1" clip="idleBabySource" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="idleTransition">
            <animation id="idle1" clip="idleBabySource" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="graze">
            <animation id="graze1" clip="idleBabySource" distance="0" />
        </state>
        <state id="sleep">
            <animation id="sleep1" clip="sleepSideLBabySource" speed="1.0" distance="0" />
            <animation id="sleep2" clip="sleepSideRBabySource" speed="1.0" distance="0" />
        </state>
        <state id="rest">
            <animation id="rest1" clip="restSideLBabySource" speed="1.0" distance="0" />
            <animation id="rest2" clip="restSideRBabySource" speed="1.0" distance="0" />
            <animation id="rest3" clip="restMBabySource" speed="1.0" distance="0" />
        </state>
        <state id="chew">
            <animation id="chew1" clip="idleBabySource" weight="1" speed="1.25" distance="0" />
        </state>
        <state id="turnLeft">
            <animation id="turnLeft1" clip="turn45LBabySource" rotation="45" distance="0" />
            <animation id="turnLeft2" clip="turn90LBabySource" rotation="90" distance="0" />
            <animation id="turnLeft3" clip="turn135LBabySource" rotation="135" distance="0" />
            <animation id="turnLeft4" clip="turn180LBabySource" rotation="180" distance="0" />
        </state>
        <state id="turnRight">
            <animation id="turnRight1" clip="turn45RBabySource" rotation="45" distance="0" />
            <animation id="turnRight2" clip="turn90RBabySource" rotation="90" distance="0" />
            <animation id="turnRight3" clip="turn135RBabySource" rotation="135" distance="0" />
            <animation id="turnRight4" clip="turn180RBabySource" rotation="180" distance="0" />
        </state>
    </states>
    <transitions defaultBlendTime="750">
        <transition animationIdFrom="idle1" animationIdTo="sleep1" clip="idleBaby_to_sleepSideLBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep2" clip="idleBaby_to_sleepSideRBabySource" targetTime="0" />
        <transition animationIdFrom="sleep1" animationIdTo="idle1" clip="sleepSideLBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="sleep2" animationIdTo="idle1" clip="sleepSideRBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest1" clip="idleBaby_to_restSideLBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest2" clip="idleBaby_to_restSideRBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest3" clip="idleBaby_to_restMBabySource" targetTime="0" />
        <transition animationIdFrom="rest1" animationIdTo="idle1" clip="restSideLBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest2" animationIdTo="idle1" clip="restSideRBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest3" animationIdTo="idle1" clip="restMBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk1" blendTime="1000" targetTime="0" />
        <transition animationIdFrom="walk1" animationIdTo="idle1" blendTime="1000" targetTime="0" />
    </transitions>
</animation>