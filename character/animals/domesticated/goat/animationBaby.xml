<?xml version="1.0" encoding="utf-8" standalone="no"?>
<animation>
    <states>
        <state id="walk">
            <animation id="walk1" clipLeft="walkFwdLBabySource" clipRight="walkFwdRBabySource" rotation="65" speed="1" distance="0.61" />
            <animation id="walk2" clipLeft="walkFwdGrazeLBabySource" clipRight="walkFwdGrazeRBabySource" rotation="65" speed="0.1" distance="0.364" />
            <animation id="walk3" clipLeft="trotFwdLBabySource" clipRight="trotFwdRBabySource" rotation="65" speed="1.7" distance="0.634" />
            <animation id="walk4" clipLeft="runFwdLBabySource" clipRight="runFwdRBabySource" rotation="65" speed="3.63" distance="1.086" />
        </state>
        <state id="idle">
            <animation id="idle1" clip="idleBabySource" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="idleTransition">
            <animation id="idle1" clip="idleBabySource" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="graze">
            <animation id="graze1" clip="grazeBabySource" distance="0" />
        </state>
        <state id="sleep">
            <animation id="sleep1" clip="sleepSideLBabySource" speed="1.0" distance="0" />
            <animation id="sleep2" clip="sleepSideRBabySource" speed="1.0" distance="0" />
            <animation id="sleep3" clip="sleepMBabySource" speed="1.0" distance="0" />
        </state>
        <state id="rest">
            <animation id="rest1" clip="restSideBabyLSource" speed="1.0" distance="0" />
            <animation id="rest2" clip="restSideBabyRSource" speed="1.0" distance="0" />
            <animation id="rest3" clip="restMBabySource" speed="1.0" distance="0" />
        </state>
        <state id="chew">
            <animation id="chew1" clip="chewBabySource" weight="1" speed="1" distance="0" />
        </state>
        <state id="turnLeft">
            <animation id="turnLeft1" clip="turn45LBabySource" rotation="45" distance="0" />
            <animation id="turnLeft2" clip="turn90LBabySource" rotation="90" distance="0" />
            <animation id="turnLeft3" clip="turn135LBabySource" rotation="135" distance="0" />
            <animation id="turnLeft4" clip="turn180LBabySource" rotation="180" distance="0" />
        </state>
        <state id="turnRight">
            <animation id="turnRight1" clip="turn45RBabySource" rotation="45" distance="0" />
            <animation id="turnRight2" clip="turn90RBabySource" rotation="90" distance="0" />
            <animation id="turnRight3" clip="turn135RBabySource" rotation="135" distance="0" />
            <animation id="turnRight4" clip="turn180RBabySource" rotation="180" distance="0" />
        </state>
    </states>
    <transitions defaultBlendTime="750">
        <transition animationIdFrom="idle1" animationIdTo="graze1" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="graze1" animationIdTo="idle1" clip="grazeBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="graze1" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="graze1" animationIdTo="chew1" clip="grazeBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep1" clip="idleBaby_to_sleepSideLBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep2" clip="idleBaby_to_sleepSideRBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep3" clip="idleBaby_to_sleepMBabySource" targetTime="0" />
        <transition animationIdFrom="sleep1" animationIdTo="idle1" clip="sleepSideLBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="sleep2" animationIdTo="idle1" clip="sleepSideRBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="sleep3" animationIdTo="idle1" clip="sleepMBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest1" clip="idleBaby_to_restSideLBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest2" clip="idleBaby_to_restSideRBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest3" clip="idleBaby_to_restMBabySource" targetTime="0" />
        <transition animationIdFrom="rest1" animationIdTo="idle1" clip="restSideLBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest2" animationIdTo="idle1" clip="restSideRBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest3" animationIdTo="idle1" clip="restMBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest1" clip="idleBaby_to_restSideLBabySource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest2" clip="idleBaby_to_restSideRBabySource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest3" clip="idleBaby_to_restMBabySource" targetTime="0" />
        <transition animationIdFrom="rest1" animationIdTo="chew1" clip="restSideLBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest2" animationIdTo="chew1" clip="restSideRBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="rest3" animationIdTo="chew1" clip="restMBaby_to_idleBabySource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk1" blendTime="500" targetTime="0" />
        <transition animationIdFrom="walk1" animationIdTo="idle1" blendTime="500" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk4" blendTime="300" targetTime="0" />
        <transition animationIdFrom="walk4" animationIdTo="idle1" blendTime="300" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnLeft1" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnLeft2" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnLeft3" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnLeft4" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnRight1" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnRight2" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnRight3" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
        <transition animationIdFrom="turnRight4" animationIdTo="walk2" clip="idleBaby_to_grazeBabySource" targetTime="0" />
    </transitions>
</animation>