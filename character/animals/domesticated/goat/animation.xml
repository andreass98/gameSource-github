<?xml version="1.0" encoding="utf-8" standalone="no"?>
<animation>
    <states>
        <state id="walk">
            <animation id="walk1" clipLeft="walkFwdLSource" clipRight="walkFwdRSource" rotation="65" speed="1.0" distance="1.00" />
            <animation id="walk2" clipLeft="walkFwdGrazeLSource" clipRight="walkFwdGrazeRSource" rotation="65" speed="0.1" distance="0.51" />
            <animation id="walk3" clipLeft="trotFwdLSource" clipRight="trotFwdRSource" rotation="65" speed="1.84" distance="1.00" />
        </state>
        <state id="run">
            <animation id="run1" clipLeft="runFwdLSource" clipRight="runFwdRSource" rotation="35" speed="4" distance="1.63" />
        </state>
        <state id="idle">
            <animation id="idle1" clip="idle1Source" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="idleTransition">
            <animation id="idle1" clip="idle1Source" distance="0" speed="1.0" rotation="0" />
        </state>
        <state id="graze">
            <animation id="graze1" clip="grazeSource" distance="0" />
        </state>
        <state id="eat">
            <animation id="eat1" clip="feedSource" speed="1.0" distance="0" />
        </state>
        <state id="drink">
            <animation id="drink" clip="drinkSource" speed="1.0" distance="0" />
        </state>
        <state id="sleep">
            <animation id="sleep1" clip="sleepSideLSource" speed="1.0" distance="0" />
            <animation id="sleep2" clip="sleepSideRSource" speed="1.0" distance="0" />
            <animation id="sleep3" clip="sleepMSource" speed="1.0" distance="0" />
        </state>
        <state id="rest">
            <animation id="rest1" clip="restSideLSource" speed="1.0" distance="0" />
            <animation id="rest2" clip="restSideRSource" speed="1.0" distance="0" />
            <animation id="rest3" clip="restMSource" speed="1.0" distance="0" />
        </state>
        <state id="chew">
            <animation id="chew1" clip="chewSource" weight="1" speed="1" distance="0" />
        </state>
        <state id="turnLeft">
            <animation id="turnLeft1" clip="turn45LSource" rotation="45" distance="0" />
            <animation id="turnLeft2" clip="turn90LSource" rotation="90" distance="0" />
            <animation id="turnLeft3" clip="turn135LSource" rotation="135" distance="0" />
            <animation id="turnLeft4" clip="turn180LSource" rotation="180" distance="0" />
        </state>
        <state id="turnRight">
            <animation id="turnRight1" clip="turn45RSource" rotation="45" distance="0" />
            <animation id="turnRight2" clip="turn90RSource" rotation="90" distance="0" />
            <animation id="turnRight3" clip="turn135RSource" rotation="135" distance="0" />
            <animation id="turnRight4" clip="turn180RSource" rotation="180" distance="0" />
        </state>
    </states>
    <transitions defaultBlendTime="750">
        <transition animationIdFrom="idle1" animationIdTo="graze1" clip="idle_to_grazeSource" targetTime="0" />
        <transition animationIdFrom="graze1" animationIdTo="idle1" clip="graze_to_idleSource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="graze1" clip="idle_to_grazeSource" targetTime="0" />
        <transition animationIdFrom="graze1" animationIdTo="chew1" clip="graze_to_idleSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep1" clip="idle_to_sleepSideLSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep2" clip="idle_to_sleepSideRSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="sleep3" clip="idle_to_sleepMSource" targetTime="0" />
        <transition animationIdFrom="sleep1" animationIdTo="idle1" clip="sleepSideL_to_idleSource" targetTime="0" />
        <transition animationIdFrom="sleep2" animationIdTo="idle1" clip="sleepSideR_to_idleSource" targetTime="0" />
        <transition animationIdFrom="sleep3" animationIdTo="idle1" clip="sleepM_to_idleSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest1" clip="idle_to_restSideLSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest2" clip="idle_to_restSideRSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="rest3" clip="idle_to_restMSource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest1" clip="idle_to_restSideLSource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest2" clip="idle_to_restSideRSource" targetTime="0" />
        <transition animationIdFrom="chew1" animationIdTo="rest3" clip="idle_to_restMSource" targetTime="0" />
        <transition animationIdFrom="rest1" animationIdTo="idle1" clip="restSideL_to_idleSource" targetTime="0" />
        <transition animationIdFrom="rest2" animationIdTo="idle1" clip="restSideR_to_idleSource" targetTime="0" />
        <transition animationIdFrom="rest3" animationIdTo="idle1" clip="restM_to_idleSource" targetTime="0" />
        <transition animationIdFrom="rest1" animationIdTo="chew1" clip="restSideL_to_idleSource" targetTime="0" />
        <transition animationIdFrom="rest2" animationIdTo="chew1" clip="restSideR_to_idleSource" targetTime="0" />
        <transition animationIdFrom="rest3" animationIdTo="chew1" clip="restM_to_idleSource" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk1" blendTime="600" targetTime="0" />
        <transition animationIdFrom="walk1" animationIdTo="idle1" blendTime="400" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk3" blendTime="600" targetTime="0" />
        <transition animationIdFrom="walk3" animationIdTo="idle1" blendTime="400" targetTime="0" />
        <transition animationIdFrom="idle1" animationIdTo="walk2" clip="idle_to_grazeSource" targetTime="0" />
    </transitions>
</animation>