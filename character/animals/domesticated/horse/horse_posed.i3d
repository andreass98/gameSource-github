<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="horse_posed" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/tileAndMirrorShader.xml" />
    <File fileId="1" filename="$dataS/character/animals/domesticated/horse/horse_diffuse.png" />
    <File fileId="2" filename="$dataS/character/animals/domesticated/horse/horse_normal.png" />
    <File fileId="3" filename="$dataS/character/animals/domesticated/horse/horse_specular.png" />
    <File fileId="5" filename="$dataS/character/animals/domesticated/horse/maneTailBraide_diffuse.png" />
    <File fileId="6" filename="$dataS/character/animals/domesticated/horse/maneTailBraide_normal.png" />
    <File fileId="7" filename="$dataS/character/animals/domesticated/horse/maneTailBraide_specular.png" />
  </Files>

  <Materials>
    <Material name="horse_mat" materialId="1" customShaderId="4" customShaderVariation="DIRT_ENABLED">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="0.25 0.5 0 0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1 1 0 0"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="maneTailBraide_mat" materialId="2" customShaderId="4" customShaderVariation="ALPHA_FROM_SPECULAR">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="0.25 0.5 0 0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1 1 0 0"/>
      <Texture fileId="5"/>
      <Normalmap fileId="6"/>
      <Glossmap fileId="7"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="horse_posed.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="body" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="150" nodeId="1"/>
    <Shape name="maneTail" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="2" clipDistance="150" nodeId="2"/>
  </Scene>

</i3D>
