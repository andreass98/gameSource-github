            <animation id="turnLeft3" clip="turn135LSource" rotation="135" distance="0" />
            <animation id="turnLeft4" clip="turn180LSource" rotation="180" distance="0" />
        </state>
        <state id="turnRight">
            <animation id="turnRight1" clip="turn45RSource" rotation="45" distance="0" />
            <animation id="turnRight2" clip="turn90RSource" rotation="90" distance="0" />
            <animation id="turnRight3" clip="turn135RSource" rotation="135" distance="0" />
            <animation id="turnRight4" clip="turn180RSource" rotation="180" distance="0" />
        </state>
