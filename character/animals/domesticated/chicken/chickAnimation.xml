            <animation id="walk2" clipLeft="walkFwdGrazeLSource" clipRight="walkFwdGrazeRSource" rotation="65" speed="0.137" distance="0.4813" />
            <animation id="walk3" clipLeft="trotFwdLSource" clipRight="trotFwdRSource" rotation="65" speed="1.2" distance="0.75" />
            <animation id="walk4" clipLeft="runFwdLSource" clipRight="runFwdRSource" rotation="35" speed="3.3" distance="1" />
        </state>
        <state id="run">
            <animation id="run1" clipLeft="runFwdLSource" clipRight="runFwdRSource" rotation="35" speed="6" distance="2" />
        </state>
        <state id="idle">
            <animation id="idle1" clip="idle1Source" distance="0" speed="1.0" rotation="0" />
