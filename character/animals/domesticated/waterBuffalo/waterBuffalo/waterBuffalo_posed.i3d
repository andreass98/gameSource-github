  <Materials>
    <Material name="waterBuffalo_mat1" materialId="1" customShaderId="4" customShaderVariation="sssSpecularDirt">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="0.5 0.5 0 0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1.0 1.0 0 0"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="waterBuffalo_mat" materialId="2" customShaderId="4" customShaderVariation="sssSpecularDirt_alphaMapSecondUV_normalMapSecondUV">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="0.5 0.5 0 0"/>
      <CustomParameter name="dirt" value="0 20.0 20.0"/>
      <CustomParameter name="dirtColor" value="0.20 0.14 0.08 0.0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1.0 1.0 0 0"/>
      <CustomParameter name="sssColor" value=".8 .8 .8 1.0"/>
      <Custommap name="alphaMap" fileId="6"/>
      <Texture fileId="1"/>
      <Normalmap fileId="5"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="waterBuffaloHorns_mat" materialId="3">
      <Texture fileId="7"/>
      <Normalmap fileId="8"/>
      <Glossmap fileId="9"/>
    </Material>
  </Materials>


