    <File fileId="3" filename="$dataS/character/animals/domesticated/cow/highland/cattleHighland_specular.png" />
  </Files>

  <Materials>
    <Material name="cattleHighland_02_mat" materialId="1" customShaderId="4" customShaderVariation="sssSpecularDirt">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="1 1 1 0"/>
      <CustomParameter name="dirt" value="0 20.0 20.0"/>
      <CustomParameter name="dirtColor" value="0.20 0.14 0.08 0.0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1 1 0 0.5"/>
      <CustomParameter name="sssColor" value="0.938 0.938 0.938 1.0"/>
      <Custommap name="dirtNmap" fileId="3"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="cattleHighland_01_mat" materialId="2" customShaderId="4" customShaderVariation="sssSpecularDirt_alphaMapSecondUV">
      <CustomParameter name="atlasInvSizeAndOffsetUV" value="1 1 1 0"/>
      <CustomParameter name="dirt" value="0 20.0 20.0"/>
      <CustomParameter name="dirtColor" value="0.20 0.14 0.08 0.0"/>
      <CustomParameter name="mirrorScaleAndOffsetUV" value="1 1 0 0.5"/>
      <CustomParameter name="sssColor" value="0.938 0.567 0.567 1.0"/>
      <Custommap name="alphaMap" fileId="5"/>
      <Custommap name="dirtNmap" fileId="3"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="cattleHighland_posed.i3d.shapes">
  </Shapes>

