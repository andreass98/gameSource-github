<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="cattleHighland_posed" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/tileAndMirrorShader.xml" />
