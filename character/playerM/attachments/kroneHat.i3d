<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="kroneHat" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/characterShader.xml" />
    <File fileId="1" filename="$dataS/character/textures/accessory/head/hats/headgearBallcap_diffuse.png" />
    <File fileId="5" filename="$dataS/character/textures/accessory/head/hats/headgearBallcap_mask.png" />
    <File fileId="2" filename="$dataS/character/textures/accessory/head/hats/headgearBallcap_normal.png" />
    <File fileId="3" filename="$dataS/character/textures/accessory/head/hats/headgearBallcap_specular.png" />
    <File fileId="6" filename="$dataS/character/textures/accessory/head/hats/kroneLogo_diffuse.png" />
    <File fileId="7" filename="$dataS/character/textures/default_normal.png" />
    <File fileId="8" filename="$dataS/character/textures/default_specular.png" />
  </Files>

  <Materials>
    <Material name="headgearBallcap_05_mat" materialId="1" customShaderId="4">
      <CustomParameter name="colorScaleG" value="0.08 0.08 0.08 1.0"/>
      <CustomParameter name="colorScaleR" value="0.51 0.51 0.51 1.0"/>
      <CustomParameter name="sssColor" value="0.938 0.938 0.938 1.0"/>
      <Custommap name="mMaskMap" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
    <Material name="kroneLogo_02_mat" materialId="2">
      <Texture fileId="6"/>
      <Normalmap fileId="7"/>
      <Glossmap fileId="8"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="kroneHat.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="animationRootNode" nodeId="1"/>
    <TransformGroup name="kroneHat" nodeId="2">
      <Shape name="kroneHat" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="3"/>
      <Shape name="kroneDecal" shapeId="2" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="2" clipDistance="50" nodeId="4"/>
    </TransformGroup>
  </Scene>

</i3D>
