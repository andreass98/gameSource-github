      <Custommap name="mMaskMap" fileId="9"/>
      <Texture fileId="6"/>
      <Normalmap fileId="7"/>
      <Glossmap fileId="8"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="construction.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="GEO" collision="false" collisionFilterMask="0xfffffbff" clipDistance="300" nodeId="1">
      <TransformGroup name="constructionVest" nodeId="2">
        <Shape name="helmetRing" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="3"/>
        <Shape name="helmet" shapeId="2" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="300" nodeId="4"/>
