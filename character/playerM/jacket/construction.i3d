      <CustomParameter name="colorScaleG" value="0.12 0.12 0.12 1.0"/>
      <CustomParameter name="colorScaleR" value="1.0 1.0 1.0 1.0"/>
      <CustomParameter name="dirtColor" value="0.20 0.14 0.08 0.0"/>
